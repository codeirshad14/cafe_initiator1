# .env in the project folder on the server. Make it readable by the app user only:
#   chmod 600 .env

# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=paste-a-new-long-random-key-here
DEBUG=False
ALLOWED_HOSTS=order.example.com
CSRF_TRUSTED_ORIGINS=https://order.example.com

# the address printed in the table QR codes
SITE_URL=https://order.example.com

USE_SQLITE=False
DB_NAME=resto_db
DB_USER=resto
DB_PASSWORD=paste-the-postgres-password-here
DB_HOST=localhost
DB_PORT=5432

# turn on once HTTPS works for every page (browsers then refuse plain HTTP for a year)
SECURE_HSTS_SECONDS=0

# the shared cache (wrong-password counts): the "cache" folder inside the project.
# Best left out. If set, it must be a folder the app's user can write
# (deploy/update.sh makes it so on every update).
#CACHE_DIR=

CONTACT_PHONE=
CONTACT_EMAIL=
