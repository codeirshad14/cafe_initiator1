# Production settings for cafe.initiatorsolutions.com (deploy/DEPLOY.md).
# On the server: cp .env.example .env && chmod 600 .env
# It holds the real database password and secret key: keep this file private
# (never in git, never sent around). For development on your PC, use .env with
# DEBUG=True and USE_SQLITE=True instead.

SECRET_KEY=a6q9SQBIaZrr914ZUZEaL6xRLta2y6nOgNAUhWnxc7D3B6pYOUKwUjW8PN1mhT6dhHc
DEBUG=False
ALLOWED_HOSTS=cafe.initiatorsolutions.com
CSRF_TRUSTED_ORIGINS=https://cafe.initiatorsolutions.com

# the address printed in the table QR codes
SITE_URL=https://cafe.initiatorsolutions.com

# PostgreSQL
USE_SQLITE=False
DB_NAME=incafe1
DB_USER=resto
DB_PASSWORD=CCXcafe@&*(
DB_HOST=localhost
DB_PORT=5432

# turn on once HTTPS works for every page (browsers then refuse plain HTTP for a year): 31536000
SECURE_HSTS_SECONDS=0

# the shared cache (wrong-password counts)
CACHE_DIR=/srv/resto/cache

# shown on the website's contact section and upgrade messages (hidden when empty).
# Phone with country code, e.g. +91 98765 43210 (also used for the WhatsApp link)
