# A template only: it is in git (and the repository is public), so never put real
# passwords or keys here.
# Development: copy to .env (DEBUG=True, USE_SQLITE=True).
# The server: .env.production (not in git) copied to /srv/resto/.env, or deploy/env.production.example.
SECRET_KEY=put-a-long-random-string-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# on the server: https://cafe.initiatorsolutions.com
CSRF_TRUSTED_ORIGINS=
# address inside the table QR codes; empty = the one you browse on.
# To test with a phone on your Wi-Fi: http://<your-PC-IP>:8000
SITE_URL=
# shown on the public website's contact section (hidden when empty).
# Phone with country code, e.g. +91 98765 43210 (also used for the WhatsApp link)
CONTACT_PHONE=
CONTACT_EMAIL=

# True  = development: SQLite file db.sqlite3, nothing to install
# False = PostgreSQL with the DB_* values below (use this on the server)
USE_SQLITE=True

DB_NAME=incafe1
DB_USER=incafe1
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432
